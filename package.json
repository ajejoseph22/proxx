  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.13.1",
    "prettier": "^3.4.2",
    "ts-node-dev": "^2.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "lodash.merge": "^4.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
