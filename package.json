{
  "name": "proxx",
  "version": "1.0.0",
  "main": "index.ts",
  "repository": "https://github.com/ajejoseph22/proxx.git",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write .",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "ts-node src/index.ts"
  },
  "keywords": ["proxy", "server", "https", "http"],
